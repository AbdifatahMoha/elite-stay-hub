# EliteStay — Supabase configuration
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values from Supabase Dashboard → Project Settings → API
# 3. Restart the dev server: npm run dev

# Public (safe for browser — Vite exposes VITE_* variables)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with VITE_ and NEVER commit real values
# Required for Admin → Staff Management → Create Staff (inviteUserByEmail)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres URI for npm run db:migrate
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: redirect URL in staff invitation emails
APP_URL=http://localhost:8080
