# EliteStay — Supabase configuration
# Local: copy this file to .env and fill in values from
#   Supabase Dashboard → Project Settings → API
# Railway: add the same names under the service → Variables, then redeploy.
#   VITE_* are public (browser). Never prefix the service role key with VITE_.

# Public (safe for browser — Vite exposes VITE_* variables)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with VITE_ and NEVER commit real values
# Required for Admin → Staff Management → Create Staff (inviteUserByEmail)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (Railway: https://your-service.up.railway.app)
APP_URL=http://localhost:8080

# Optional: direct Postgres URI for npm run db:migrate
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
